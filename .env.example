# Configuración de la aplicación
APP_NAME="WorkSpace IT"
APP_ENV=local
APP_URL=http://localhost/workspace-it
APP_DEBUG=true

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workspace_it
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Seguridad y sesiones
SESSION_SECRET=
SESSION_LIFETIME=120

# Correo SMTP de pruebas (Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@workspaceit.local
MAIL_FROM_NAME="WorkSpace IT"
